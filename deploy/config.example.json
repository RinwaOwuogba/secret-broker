{
  "listen": "127.0.0.1:8080",
  "secretsDir": "/etc/secret-broker/secrets",
  "upstreams": {
    "tw": {
      "base": "https://api.twitterapi.io",
      "header": "x-api-key",
      "secret": "twitterapi",
      "allow": [["GET", "^/twitter/.+"]]
    },
    "cr": {
      "base": "https://api.cryptorank.io",
      "header": "X-Api-Key",
      "secret": "cryptorank",
      "allow": [["GET", "^/v2/.+"]]
    },
    "gh": {
      "base": "https://api.github.com",
      "inject": "bearer",
      "secret": "github",
      "allow": [
        ["GET", "^/repos/[^/]+/[^/]+(/.*)?$"],
        ["POST", "^/repos/[^/]+/[^/]+/(issues|pulls)(/.*)?$"]
      ]
    },
    "ghgit": {
      "base": "https://github.com",
      "mode": "git",
      "inject": "github-basic",
      "secret": "github",
      "allow": [
        ["GET", "^/[^/]+/[^/]+/info/refs$"],
        ["POST", "^/[^/]+/[^/]+/git-upload-pack$"],
        ["POST", "^/[^/]+/[^/]+/git-receive-pack$"]
      ]
    }
  },
  "agents": {
    "scout": { "tokenRef": "token_scout", "selectors": ["tw", "cr"] },
    "dev": { "tokenRef": "token_dev", "selectors": ["gh", "ghgit"] }
  }
}
