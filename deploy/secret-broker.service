[Unit]
Description=secret-broker credential-injecting egress proxy
After=network-online.target
Wants=network-online.target

[Service]
# Runs unprivileged. Secrets are owned root:broker 0640, so this user can read
# them but cannot alter them; the agent user (e.g. dev) is excluded entirely.
User=broker
Group=broker
ExecStart=/usr/local/bin/secret-broker serve -config /etc/secret-broker/config.json
Restart=on-failure
RestartSec=2

# --- hardening ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadOnlyPaths=/etc/secret-broker

# --- roadmap: move secrets off-disk entirely ---
# Encrypt once:  systemd-creds encrypt --name=twitterapi plain.txt /etc/credstore.encrypted/twitterapi
# Then load into a ramfs dir (0400, this user only) and point secretsDir at it:
#   LoadCredentialEncrypted=twitterapi:/etc/credstore.encrypted/twitterapi
#   Environment=SECRETS_DIR=%d        # %d == $CREDENTIALS_DIRECTORY
# (DirStore works unchanged against $CREDENTIALS_DIRECTORY.)

[Install]
WantedBy=multi-user.target
